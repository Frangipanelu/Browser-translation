{
  "manifest_version": 3,
  "name": "划词翻译助手",
  "version": "1.0.0",
  "description": "选中即翻译（中英双向），音标+词性释义+TTS发音，标签单词本，Obsidian 同步。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "划词翻译助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.dictionaryapi.dev/*"],
  "commands": {
    "open-wordbook": {
      "suggested_key": {
        "default": "Ctrl+Shift+W"
      },
      "description": "打开单词本"
    }
  }
}
